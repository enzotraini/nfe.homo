# Copie este arquivo para .env e preencha na sua máquina.
# O .env não vai para o Git. Não coloque senha, certificado nem CNPJ real aqui.
#
#   cp .env.example .env

PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# mock = responde local, sem certificado e sem falar com a SEFIN.
# http = chama a SEFIN de verdade (mTLS com o A1 abaixo).
SEFIN_MODE=mock

# ---------------------------------------------------------------------------
# Ambiente de teste (produção restrita)
# Nota autorizada aqui NÃO tem valor fiscal.
# Use o certificado A1 de quem for testar. tpAmb da DPS sai como 2.
#
# SEFIN_ENV=producao-restrita
# SEFIN_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional
# ---------------------------------------------------------------------------
SEFIN_ENV=producao-restrita
SEFIN_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional

# ---------------------------------------------------------------------------
# Ambiente de produção
# Nota autorizada aqui É documento fiscal. Só troque quando for emitir de verdade.
# tpAmb da DPS sai como 1.
# Em São Paulo, optante do Simples pode receber E0084 enquanto o CNPJ
# não estiver no CNC da SEFIN Nacional (previsão oficial: 1º/11/2026).
#
# SEFIN_ENV=producao
# SEFIN_BASE_URL=https://sefin.nfse.gov.br/SefinNacional
# ---------------------------------------------------------------------------

# Certificado A1 do contribuinte (.p12 / .pfx). Só é lido com SEFIN_MODE=http.
# O arquivo fica em certs/ e também não vai para o Git.
# Cada instalação usa o próprio certificado. Não compartilhe o de outra empresa.
SEFIN_CERT_PATH=./certs/cliente.p12
SEFIN_CERT_PASSWORD=

# Timeout das chamadas à SEFIN, em milissegundos.
SEFIN_TIMEOUT_MS=30000
