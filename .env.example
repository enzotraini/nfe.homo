PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# mock = sem certificado | http = SEFIN real (precisa A1)
SEFIN_MODE=mock

# producao-restrita | producao
SEFIN_ENV=producao-restrita
SEFIN_BASE_URL=https://sefin.producaorestrita.nfse.gov.br/SefinNacional

# Certificado A1 do contribuinte (mTLS) — só usado com SEFIN_MODE=http
SEFIN_CERT_PATH=./certs/cliente.p12
SEFIN_CERT_PASSWORD=

# Timeout das chamadas à SEFIN (ms)
SEFIN_TIMEOUT_MS=30000
